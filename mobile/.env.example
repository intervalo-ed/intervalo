# Copiar a `.env` (gitignoreado). Todo lo EXPO_PUBLIC_ queda inlineado en el
# bundle: acá no va nada secreto.

# El backend. En el simulador de iOS localhost es la Mac; en el emulador de
# Android es http://10.0.2.2:8000. Nunca la API de producción para probar.
EXPO_PUBLIC_API_URL=http://localhost:8000

# La misma publishable key de Clerk que usa la web (pk_test_… o pk_live_…).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sin key, PostHog no se inicializa y `track()` no hace nada.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
