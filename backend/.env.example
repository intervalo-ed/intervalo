# ── Backend environment variables ────────────────────────────────────────────
# Copy to `.env` and fill in real values.

# Database — defaults to a local SQLite file if unset.
# For Postgres: postgresql://user:password@host:5432/dbname
# (Railway's legacy `postgres://` scheme is normalized automatically.)
DATABASE_URL=sqlite:///./intervalo.db

# CORS — comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# ── Clerk ────────────────────────────────────────────────────────────────────
# Find these in your Clerk dashboard → API Keys → "Show JWT public key" / "Show API URLs".
# The backend verifies Clerk session JWTs against the JWKS endpoint (RS256).

# JWKS URL — used to fetch and cache Clerk's public signing keys.
# e.g. https://clean-beagle-42.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Issuer — the `iss` claim on Clerk-issued session tokens. Must match exactly.
# e.g. https://clean-beagle-42.clerk.accounts.dev
CLERK_ISSUER=

# Audience — only set this if you use a custom session template that emits `aud`.
# Leave empty to skip the `aud` check (Clerk's default templates don't include it).
# CLERK_AUDIENCE=

# Backend API secret key — optional. Only needed if your session JWT template
# doesn't expose `email` / `name` on the token, in which case we'll fetch them
# from api.clerk.com on first sight of a new user.
# e.g. sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=

# Webhook signing secret — Clerk dashboard → Webhooks → el endpoint → Signing
# Secret (empieza con "whsec_"). Con esto el backend crea la fila de `users`
# apenas Clerk confirma el alta, sin depender de que el navegador llegue a
# hacer su primera request: ese camino perdía el 15% de las cuentas.
# Suscribir el endpoint https://<api>/webhooks/clerk a user.created y user.updated.
CLERK_WEBHOOK_SECRET=

# ── Push notifications ───────────────────────────────────────────────────────
# Shared secret the notifier worker sends as `X-Internal-Secret` to call the
# /internal/* endpoints. Must match the worker's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=

# ── Feedback (Resend) ────────────────────────────────────────────────────────
# API key de Resend → https://resend.com/api-keys (empieza con "re_").
# Sin esta key el feedback se guarda en la DB igual, solo no se manda el mail.
RESEND_API_KEY=

# Destinatario del mail de feedback. Default: nvrancovich@gmail.com
FEEDBACK_TO_EMAIL=nvrancovich@gmail.com

# Remitente. `onboarding@resend.dev` funciona sin verificar dominio (pero solo
# envía al mail de tu cuenta Resend). Para producción, usá un dominio verificado.
FEEDBACK_FROM_EMAIL=onboarding@resend.dev

# ── Emails de retención (Resend) ─────────────────────────────────────────────
# Usa la misma RESEND_API_KEY de arriba. Requiere un dominio verificado (no
# funciona con onboarding@resend.dev, que solo manda al mail de tu cuenta).
LIFECYCLE_FROM_EMAIL=Intervalo <hola@comms.intervalo.xyz>

# Firma HMAC de los links de "Desuscribirse" (no requieren login). Cualquier
# string random largo sirve — generalo con `openssl rand -hex 32`.
EMAIL_UNSUB_SECRET=

# Base para armar los links del CTA y de desuscripción en los emails.
APP_BASE_URL=https://www.intervalo.xyz
API_BASE_URL=https://api.intervalo.xyz

# ── Minijuego de derivadas ───────────────────────────────────────────────────
# El chat del panel de ranking. APAGADO por defecto y a propósito: es el único
# lugar del juego donde lo que escribe una persona aparece en la pantalla de
# todas las demás, y no hay moderación automática más allá del saneado (letras,
# números y puntuación; sin links). Prenderlo cuando haya alguien mirando.
#
# Solo controla ESCRIBIR. Leer el chat anda siempre.
GAME_CHAT_ENABLED=
